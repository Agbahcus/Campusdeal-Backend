# Django Settings
SECRET_KEY=django-insecure-change-this-in-production-use-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,campusdeal-backend.onrender.com

# Database (SQLite for now, switch to PostgreSQL in production)
DATABASE_URL=sqlite:///db.sqlite3

# SMS Configuration (Termii for Nigeria)
TERMII_API_KEY=your-termii-api-key-here
TERMII_SENDER_ID=CampusDeal

# Payment Configuration (Paystack)
# Get these from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here

# Frontend URL (for CORS and callbacks)
FRONTEND_URL=http://localhost:3000

# Email Configuration (optional, for future use)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Security Settings (set to False in production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
